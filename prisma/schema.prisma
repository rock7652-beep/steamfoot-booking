  @@unique([storeId, number])
  @@unique([storeId, name])
  @@unique([storeId, id])
}
model CustomerLabel {
  position Int @default(0)
  id String @id @default(cuid())
  storeId String
  categoryId String
  name String
  active Boolean @default(true)
  @@unique([storeId, categoryId, name])
  @@unique([storeId, id])
}
model CustomerLabelAssignment {
  storeId String
  customerId String
  labelId String
  @@id([storeId, customerId, labelId])
  @@index([storeId, labelId, customerId])
}
model TrialApplication {
  id                 String   @id @default(uuid())
  requestId          String   @unique
  resumeTokenHash    String
  storeName          String
  contactEmail       String
  payload            Json
  status             String   @default("RECEIVED")
  notificationStatus String   @default("PENDING")
  revision           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, createdAt])
}

// Shared single-store inventory. Client roles have no direct table grants.
model InventorySupplier {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name String
  contact String
  phone String
  address String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([storeId, active])
}
model InventoryProduct {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name String
  stock Int @default(0)
  averageCost Decimal @default(0) @db.Decimal(18, 6)
  pendingCosts Json @default("{}")
  details Json @default("{}")
  price Int
  active Boolean @default(true)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([storeId, active])
}
model InventoryOrder {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  kind String // SALE / PURCHASE
  date DateTime @db.Date
  partyId String
  partyName String
  partyPhone String
  priceCategory String @default("GENERAL")
  lines Json // authoritative snapshots; costs never sent to unprivileged clients
  freight Int @default(0)
  delivery String @default("自取")
  channel String @default("")
  shippingNote String @default("")
  internalNote String @default("")
  total Int
  paid Int @default(0)
  revision Int @default(1)
  requestId String
  requestHash String
  actorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([storeId, requestId])
  @@index([storeId, kind, date])
  @@index([storeId, kind, partyId])
}
model InventoryPayment {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  kind String
  partyId String
  partyName String
  partyPhone String
  date DateTime @db.Date
  method String
  total Int
  allocations Json // orderId, amount, remainingAfter (receipt-time snapshot)
  requestId String
  requestHash String
  actorId String
  createdAt DateTime @default(now())
  @@unique([storeId, requestId])
  @@index([storeId, kind, partyId, date])
}
model InventoryStockCount {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  date DateTime @db.Date
  reason String
  lines Json // productId, name, before, actual, difference
  requestId String
  requestHash String
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@unique([storeId, requestId])
  @@index([storeId, date])
}

model InventoryCommand {
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  requestId String
  requestHash String
  orderId String
  createdAt DateTime @default(now())
  @@id([storeId, requestId])
}


model InventoryReceiving {
  store Store @relation(fields:[storeId],references:[id],onDelete:Restrict)
  id String @id @default(cuid())
  storeId String
  date DateTime @db.Date
  supplierId String @default("")
  supplierName String @default("")
  deliveryNumber String @default("")
  note String @default("")
  lines Json
  history Json
  revision Int @default(1)
  orderId String?
  requestId String
  requestHash String
  actorId String
  actorName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([storeId, requestId])
  @@index([storeId, date])
}
