// 付款狀態（與 status 獨立：status = 交易生命週期；paymentStatus = 收款確認狀態）
enum PaymentStatus {
  SUCCESS // 現金 / 刷卡 / LINE Pay 等即時付款；或歷史 backfill 值
  PENDING // 轉帳建單後待店長確認入帳（TRANSFER 預設應為此）
  CONFIRMED // 店長確認轉帳入帳（PENDING → CONFIRMED）
  FAILED // 保留：確認失敗 / 轉帳未到
  CANCELLED // 保留：交易取消後的付款取消
}

