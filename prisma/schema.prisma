// ============================================================
// Auth - NextAuth.js Models
// ============================================================

model User {
  id            String     @id @default(cuid())
  name          String
  email         String?    @unique
  phone         String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Domain relations
  staff                           Staff?
  customer                        Customer?
  customerIdentityLinks           CustomerIdentityLink[]
  staffMemberLinks                StaffMemberLink[]                @relation("StaffMemberLinkUser")
  staffMemberLinksCreated         StaffMemberLink[]                @relation("StaffMemberLinkCreator")
  healthHistoryGrants             CustomerHealthHistoryGrant[]
  centralMemberLinkReviewRequests CentralMemberLinkReviewRequest[]
  lineRebindRequestsCreated       LineRebindRequest[]              @relation("LineRebindRequestCreatedBy")
  lineRebindRequestsCancelled     LineRebindRequest[]              @relation("LineRebindRequestCancelledBy")

  // Audit
  auditLogs                   AuditLog[]
  messengerAuditRuns          MessengerAuditRun[]
  cashbookEntries             CashbookEntry[]             @relation("CashbookCreatedBy")
  opsActionLogs               OpsActionLog[]
  opsActionHistories          OpsActionHistory[]
  talentStageChanges          TalentStageLog[]            @relation("TalentStageChangedBy")
  customerFollowUps           CustomerFollowUp[]          @relation("CustomerFollowUpCreatedBy")
  digitalButlerLeadActivities DigitalButlerLeadActivity[] @relation("DigitalButlerLeadActivityCreatedBy")
  reviewedCheckinPosts        CheckinPost[]               @relation("CheckinPostReviewedBy")

  // Transaction void / audit
  voidedTransactions   Transaction[]         @relation("VoidedTransactions")
  transactionAuditLogs TransactionAuditLog[]

  // v2 退款
  refundedTransactions Transaction[] @relation("RefundedTransactions")

  // Cash Drawer（現金抽屜）
  openedCashDrawerSessions CashDrawerSession[] @relation("CashDrawerOpenedBy")
  closedCashDrawerSessions CashDrawerSession[] @relation("CashDrawerClosedBy")
  createdCashDrawerEntries CashDrawerEntry[]   @relation("CashDrawerEntryCreatedBy")

  // 首頁待處理 dismiss（個人工作台「我已知悉」狀態，per-user）
  todoDismisses TodoDismiss[]

  // 同一角色內手機不重複，但不同角色可共用手機
  @@unique([phone, role])
  @@index([phone])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

