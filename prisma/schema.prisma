model StoreLineNotificationRecipient {
  preferences           Json      @default("{}")
  legacyStaffId         String?
  sameDayBookingEnabled Boolean   @default(false)
  id                    String    @id @default(cuid())
  storeId               String
  displayName           String
  roleLabel             String
  lineUserId            String?
  bindingCode           String?   @unique
  bindingCodeExpiresAt  DateTime?
  isActive              Boolean   @default(false)
  linkedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, lineUserId])
  @@index([storeId, isActive])
}

// Digital Butler PR-1: all store-owned records are explicitly store-scoped.
model DigitalButlerTemplate {
  id         String                         @id @default(cuid())
  key        String                         @unique
  name       String
  isOfficial Boolean                        @default(true)
  createdAt  DateTime                       @default(now())
  updatedAt  DateTime                       @updatedAt
  versions   DigitalButlerTemplateVersion[]
}

model DigitalButlerTemplateVersion {
  id         String                   @id @default(cuid())
  templateId String
  version    Int
  definition Json
  createdAt  DateTime                 @default(now())
  template   DigitalButlerTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  flows      StoreDigitalButlerFlow[]

  @@unique([templateId, version])
}

model StoreDigitalButlerFlow {
  id                        String                        @id @default(cuid())
  storeId                   String
  sourceTemplateId          String?
  sourceTemplateVersionId   String?
  name                      String
  status                    DigitalButlerFlowStatus       @default(DRAFT)
  enabled                   Boolean                       @default(false)
  draftDefinition           Json?
  currentPublishedVersionId String?                       @unique
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  store                     Store                         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceTemplateVersion     DigitalButlerTemplateVersion? @relation(fields: [sourceTemplateVersionId], references: [id], onDelete: SetNull)
  versions                  DigitalButlerFlowVersion[]    @relation("FlowVersions")
  publishedVersion          DigitalButlerFlowVersion?     @relation("CurrentPublishedVersion", fields: [currentPublishedVersionId, storeId], references: [id, storeId], onDelete: Restrict)
  conversations             DigitalButlerConversation[]
  leads                     DigitalButlerLead[]

  @@unique([id, storeId])
  @@unique([currentPublishedVersionId, storeId])
  @@index([storeId, status, enabled])
  @@index([storeId])
}

model DigitalButlerFlowVersion {
  id             String                      @id @default(cuid())
  storeId        String
  flowId         String
  version        Int
  definition     Json
  publishedAt    DateTime?
  createdAt      DateTime                    @default(now())
  flow           StoreDigitalButlerFlow      @relation("FlowVersions", fields: [flowId, storeId], references: [id, storeId], onDelete: Cascade)
  currentForFlow StoreDigitalButlerFlow?     @relation("CurrentPublishedVersion")
  steps          DigitalButlerStep[]
  conversations  DigitalButlerConversation[]

  @@unique([flowId, version])
  @@unique([id, storeId])
  @@unique([id, flowId, storeId])
  @@index([storeId, flowId])
}

model DigitalButlerStep {
  id            String                   @id @default(cuid())
  storeId       String
  flowVersionId String
  stepKey       String
  position      Int
  type          DigitalButlerStepType
  config        Json
  required      Boolean                  @default(false)
  flowVersion   DigitalButlerFlowVersion @relation(fields: [flowVersionId, storeId], references: [id, storeId], onDelete: Cascade)
  answers       DigitalButlerAnswer[]

  @@unique([flowVersionId, stepKey])
  @@unique([flowVersionId, position])
  @@unique([id, storeId])
  @@index([storeId, flowVersionId])
}

model DigitalButlerConversation {
  id                 String                          @id @default(cuid())
  storeId            String
  flowId             String
  flowVersionId      String
  provider           DigitalButlerProvider           @default(LINE)
  channelAccountId   String
  senderIdHash       String
  senderIdCiphertext Bytes?
  senderIdIv         Bytes?
  senderIdAuthTag    Bytes?
  senderIdKeyVersion String?
  status             DigitalButlerConversationStatus @default(IN_PROGRESS)
  expiresAt          DateTime
  currentStepKey     String?
  cancelledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  store              Store                           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  flow               StoreDigitalButlerFlow          @relation(fields: [flowId, storeId], references: [id, storeId], onDelete: Restrict)
  flowVersion        DigitalButlerFlowVersion        @relation(fields: [flowVersionId, flowId, storeId], references: [id, flowId, storeId], onDelete: Restrict)
  answers            DigitalButlerAnswer[]
  leads              DigitalButlerLead[]
  executionLogs      DigitalButlerExecutionLog[]

  // PostgreSQL partial unique index in the PR-1 migration enforces one
  // IN_PROGRESS/WAITING_INPUT row per store + provider-scoped identity. Prisma schema
  // cannot represent that predicate, so keep this lookup index as well.
  @@unique([id, storeId])
  @@index([storeId, provider, channelAccountId, senderIdHash, status])
  @@index([storeId, expiresAt])
}

model DigitalButlerAnswer {
  id              String                    @id @default(cuid())
  storeId         String
  conversationId  String
  stepId          String
  value           Json?
  phoneCiphertext Bytes?
  phoneIv         Bytes?
  phoneAuthTag    Bytes?
  phoneHash       String?
  createdAt       DateTime                  @default(now())
  conversation    DigitalButlerConversation @relation(fields: [conversationId, storeId], references: [id, storeId], onDelete: Cascade)
  step            DigitalButlerStep         @relation(fields: [stepId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([conversationId, stepId])
  @@index([storeId, conversationId])
  @@index([storeId, phoneHash])
}

model DigitalButlerLead {
  id                    String                      @id @default(cuid())
  storeId               String
  flowId                String
  conversationId        String
  completionActionKey   String
  customerDisplayName   String?
  customerAvatarUrl     String?
  customerReference     String?
  lastMessageCiphertext Bytes?
  lastMessageIv         Bytes?
  lastMessageAuthTag    Bytes?
  lastMessageAt         DateTime?
  status                DigitalButlerLeadStatus     @default(NEW)
  submittedAnswers      Json
  phoneCiphertext       Bytes?
  phoneIv               Bytes?
  phoneAuthTag          Bytes?
  phoneHash             String?
  assignedStaffId       String?
  internalNote          String?
  lastContactedAt       DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  store                 Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  flow                  StoreDigitalButlerFlow      @relation(fields: [flowId, storeId], references: [id, storeId], onDelete: Restrict)
  conversation          DigitalButlerConversation   @relation(fields: [conversationId, storeId], references: [id, storeId], onDelete: Restrict)
  assignedStaff         Staff?                      @relation("DigitalButlerLeadAssignee", fields: [assignedStaffId, storeId], references: [id, storeId], onDelete: Restrict)
  activities            DigitalButlerLeadActivity[]

  @@unique([storeId, conversationId, completionActionKey])
  @@unique([id, storeId])
  @@index([storeId, status, createdAt])
  @@index([storeId, assignedStaffId, status])
  @@index([storeId, completionActionKey, assignedStaffId], map: "DigitalButlerLead_handoff_lookup_idx")
}

model DigitalButlerLeadActivity {
  id              String                   @id @default(cuid())
  leadId          String
  storeId         String
  createdByUserId String
  fromStatus      DigitalButlerLeadStatus?
  toStatus        DigitalButlerLeadStatus
  note            String?
  contactedAt     DateTime?
  createdAt       DateTime                 @default(now())
  lead            DigitalButlerLead        @relation(fields: [leadId, storeId], references: [id, storeId], onDelete: Cascade)
  store           Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation("DigitalButlerLeadActivityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([storeId, createdAt])
  @@index([createdByUserId])
}

model DigitalButlerExecutionLog {
  id                String                     @id @default(cuid())
  storeId           String
  provider          DigitalButlerProvider      @default(LINE)
  conversationId    String?
  webhookEventId    String?
  fallbackEventHash String?
  eventKey          String
  eventType         String
  outcome           String
  createdAt         DateTime                   @default(now())
  store             Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversation      DigitalButlerConversation? @relation(fields: [conversationId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([storeId, eventKey])
  @@index([storeId, conversationId, createdAt])
}

// ============================================================
// StoreFeatureEntitlement（單店功能授權 / 加購 / HQ 覆寫）
