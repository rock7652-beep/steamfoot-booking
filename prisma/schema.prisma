// ============================================================
// Staff（店長）
// ============================================================

model Staff {
  courseDefaultClassFee         Decimal?    @db.Decimal(10, 0) // 運動教室每堂預設授課費；空白與 0 元不同
  courseCoachEnabled            Boolean     @default(false)
  courseQualificationsConfirmed Boolean     @default(false)
  courseQualifiedTemplateIds    String[]    @default([])
  courseBirthday                DateTime?   @db.Date
  emergencyContactRelation      String      @default("")
  phone                         String      @default("")
  emergencyContactName          String      @default("")
  emergencyContactPhone         String      @default("")
  id                            String      @id @default(cuid())
  userId                        String      @unique
  storeId                       String
  displayName                   String
  colorCode                     String      @default("#6366f1") // 後台日曆識別色
  isOwner                       Boolean     @default(false)
  monthlySpaceFee               Decimal     @default(0) @db.Decimal(10, 0) // 每月固定空間分租費
  spaceFeeEnabled               Boolean     @default(false)
  status                        StaffStatus @default(ACTIVE)
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  // 名下顧客
  assignedCustomers          Customer[]          @relation("AssignedStaff")
  assignedDigitalButlerLeads DigitalButlerLead[] @relation("DigitalButlerLeadAssignee")

  // 動態權限設定（key-value）
  permissions StaffPermission[]

  // 營收歸屬（快照在 booking/transaction 上）
  revenueBookings     Booking[]     @relation("RevenueStaff")
  serviceBookings     Booking[]     @relation("ServiceStaff")
  bookedByStaff       Booking[]     @relation("BookedByStaff")
  revenueTransactions Transaction[] @relation("RevenueStaff")
  serviceTransactions Transaction[] @relation("ServiceStaff")
  soldTransactions    Transaction[] @relation("SoldByStaff")

  // 空間分租費
  spaceFeeRecords SpaceFeeRecord[]
  rentTerms       StaffRentTerm[]

  // 現金帳
  cashbookEntries CashbookEntry[] @relation("CashbookStaff")

  // 營運儀表板指派
  opsAssignments OpsActionLog[] @relation("OpsAssignee")

  // 值班安排
  dutyAssignments              DutyAssignment[]                   @relation("DutyStaff")
  dutyCreatedBy                DutyAssignment[]                   @relation("DutyCreatedBy")
  courseAvailability           CourseStaffAvailability[]
  courseAvailabilityExceptions CourseStaffAvailabilityException[]

  // 會員登入與營運人員紀錄分離。連結不改寫 Staff.userId，避免破壞舊預約、排班與結算關係。
  memberLink StaffMemberLink?
  courseManagerPersonLink CourseStaffPersonLink? @relation("CourseManagerPerson")
  courseInstructorPersonLink CourseStaffPersonLink? @relation("CourseInstructorPerson")

  // 註銷的單堂明細
  voidedSessions WalletSession[] @relation("VoidedSessions")

  @@unique([id, storeId])
  @@index([storeId])
}

// 同一個中央會員可在不同店具有不同工作身分。所有授權必須同時核對
// userId + storeId + staffId；姓名與電話只用於顯示／搜尋，絕不授權。
model StaffMemberLink {
  courseMemberEnabled Boolean   @default(true) // Course-only member/work identity switch; SPA ignores this flag.
  id                  String    @id @default(cuid())
  userId              String
  storeId             String
  staffId             String
  linkedByUserId      String?
  linkedAt            DateTime  @default(now())
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user     User  @relation("StaffMemberLinkUser", fields: [userId], references: [id], onDelete: Restrict)
  linkedBy User? @relation("StaffMemberLinkCreator", fields: [linkedByUserId], references: [id], onDelete: SetNull)
  store    Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  staff    Staff @relation(fields: [staffId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([staffId, storeId], name: "uq_staff_member_link_staff_store")
  @@unique([userId, storeId], name: "uq_staff_member_link_user_store")
  @@index([storeId, revokedAt])
  @@index([userId])
}

// Optional association between two independent work identities at the same store.
// This never grants access or changes the instructor's member/LINE login.
model CourseStaffPersonLink {
  id String @id @default(cuid())
  storeId String
  managerStaffId String
  instructorStaffId String
  linkedByUserId String?
  createdAt DateTime @default(now())

  manager Staff @relation("CourseManagerPerson", fields: [managerStaffId, storeId], references: [id, storeId], onDelete: Restrict)
  instructor Staff @relation("CourseInstructorPerson", fields: [instructorStaffId, storeId], references: [id, storeId], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@unique([managerStaffId, storeId])
  @@unique([instructorStaffId, storeId])
}

// ============================================================
// Customer（顧客）
// ============================================================

model Customer {
  @@unique([storeId, id])
  trialCarePreferences     TrialCarePreference[]
  trialCareLogs            TrialCareLog[]
  id                       String                @id @default(cuid())
  userId                   String?               @unique // nullable: 有些顧客不一定有登入帳號
  storeId                  String
  name                     String
  phone                    String
  email                    String? // 用於 Google 綁定比對（per-store unique）
  googleId                 String? // Google sub ID（per-store unique）
  avatar                   String? // Google 大頭貼 URL（未來 UI 用）
  authSource               AuthSource            @default(MANUAL) // 顧客來源（分析用）
  gender                   String? // 性別（選填）
  birthday                 DateTime?             @db.Date // 出生年月日（選填）
