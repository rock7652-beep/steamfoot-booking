  status    SpaceFeeStatus @default(PENDING)
  paidAt    DateTime?
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  storeId String
  staff   Staff  @relation(fields: [staffId], references: [id])
  store   Store  @relation(fields: [storeId], references: [id])

  @@unique([staffId, month])
  @@index([storeId])
  @@index([staffId])
  @@index([month])
}

// ============================================================
// ShopConfig（店家設定 — 方案分級用，全域唯一一筆）
// ============================================================

model ShopConfig {
  id                       String    @id @default(cuid())
  storeId                  String    @unique
  shopName                 String    @default("蒸足")
  dutySchedulingEnabled    Boolean   @default(false)
  // === PR-2 新增：前台購買頁顯示用（全 nullable；格式驗證交給 app layer）===
  bankName                 String? // 銀行名稱，例：「永豐銀行」
  bankCode                 String? // 銀行代號，例：「807」
  bankAccountNumber        String? // 帳號，例：「19301800020681」
  lineOfficialUrl          String? // LINE@ 連結，例：「https://lin.ee/UvRnFFK」
  referralShareTemplate    String? // 每店推薦分享模板；僅允許 {storeName} / {url}
  // === PR-trial 新增：體驗課設定（全有 default；不影響既有店家營運）===
  trialEnabled             Boolean   @default(true) // 是否啟用體驗單功能（關閉則隱藏「建立體驗單」入口）
  trialDefaultPrice        Decimal   @default(499) @db.Decimal(10, 0) // 預設體驗價格
  trialAllowPriceEdit      Boolean   @default(true) // 建立體驗單時是否允許調整價格
  trialMinPrice            Decimal   @default(0) @db.Decimal(10, 0) // 最低可輸入價格
  trialMaxPrice            Decimal   @default(3000) @db.Decimal(10, 0) // 最高可輸入價格
  // === PR-1 新增：顧客自助預約可預約到的日期（含當日）；null = 回到預設 +14 天 ===
  bookableUntilDate        DateTime? @db.Date
  bookingOpensAt           DateTime? // 可先排好時段，指定到點才對顧客開放
  bookingWindowDays        Int       @default(14) // 顧客可預約未來幾個 24 小時
  weeklyRecurrenceEnabled  Boolean   @default(false)
  weeklyRecurrenceMaxWeeks Int       @default(8)
  // === PR-E 新增：店家地址與 Google Maps 短網址（per-store LIFF 顯示用）===
  // 取代 src/lib/liff/messages.ts 的 storeAddress / storeMapUrl 全域常數。
  // Nullable：未填 → server resolver 回退到常數，確保任何時點 LIFF 不空白。
  address                  String? // 例：「302新竹縣竹北市中崙里科大一路80號」
  mapUrl                   String? // 例：「https://maps.app.goo.gl/EyqUvkAaHCxu6iWz5?g_st=ic」
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}

// ============================================================
// ReminderRule（提醒規則）
// ============================================================

model ReminderRule {
  id            String          @id @default(cuid())
  storeId       String
  name          String // "預約前一天提醒"
  triggerType   String // "BEFORE_BOOKING_1D", "BEFORE_BOOKING_2H", "AFTER_SERVICE_7D", "INACTIVE_30D" (legacy)
  type          String          @default("fixed") // "relative" | "fixed"
  offsetMinutes Int? // relative: 預約前 N 分鐘（例：720=12hr, 1440=24hr）
  offsetDays    Int             @default(1) // fixed: 預約前 N 天
  fixedTime     String? // fixed: 發送時間 "HH:mm"（例："20:00"）
  channel       ReminderChannel @default(LINE)
  templateId    String?
  isEnabled     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  store    Store            @relation(fields: [storeId], references: [id])
  template MessageTemplate? @relation(fields: [templateId], references: [id])
  logs     MessageLog[]

  @@index([storeId])
}

// ============================================================
// MessageTemplate（訊息模板）
// ============================================================

model MessageTemplate {
  id        String          @id @default(cuid())
  storeId   String
  name      String // "預約提醒 - 基本"
  channel   ReminderChannel @default(LINE)
  body      String // 含變數的模板內容
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  store Store          @relation(fields: [storeId], references: [id])
  rules ReminderRule[]
  logs  MessageLog[]

  @@index([storeId])
}

// ============================================================
// MessageLog（訊息發送紀錄）
// ============================================================

model MessageLog {
  id              String             @id @default(cuid())
  ruleId          String?
  templateId      String?
  customerId      String
  bookingId       String?
  courseBookingId String? // Course-specific link, scoped FK managed in SQL
  courseCardId    String? // Course card expiry/balance events
  spaBookingId    String? // SPA 獨立預約識別碼；刻意不連到蒸足 Booking FK
  // 觸發時間（UTC）— 改期後 triggerAt 變更可重新發送
  // 規範：自動規則路徑（ruleId + bookingId 同時有值）必須寫入；純手動發送可為 NULL
  triggerAt       DateTime?
  channel         ReminderChannel    @default(LINE)
  lineRoute       ReminderLineRoute?
  status          MessageLogStatus   @default(PENDING)
  renderedBody    String? // 替換變數後的實際內容
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime           @default(now())

  storeId  String
  rule     ReminderRule?    @relation(fields: [ruleId], references: [id])
  template MessageTemplate? @relation(fields: [templateId], references: [id])
  customer Customer         @relation(fields: [customerId], references: [id])
  booking  Booking?         @relation(fields: [bookingId], references: [id])
  store    Store            @relation(fields: [storeId], references: [id])

  // Successful sends are deduplicated by the partial unique index created in
  // 20260810120000. FAILED/SKIPPED attempts must remain retryable.
  @@index([ruleId, bookingId, triggerAt], map: "idx_rule_booking_trigger")
  @@index([customerId])
  @@index([bookingId])
  @@index([spaBookingId])
  @@index([courseBookingId])
  @@index([courseCardId])
  @@index([status])
  @@index([storeId])
  @@index([lineRoute])
  @@index([createdAt])
}

// ============================================================
// SessionBalanceNotification（剩餘堂數／續購通知）
// ============================================================

model SessionBalanceNotification {
  id                        String                         @id @default(cuid())
  storeId                   String
  customerId                String
  walletId                  String
  type                      SessionBalanceNotificationType
  status                    MessageLogStatus               @default(PENDING)
  renderedBody              String?
  errorMessage              String?
  sentAt                    DateTime?
  deliveryVersion           Int                            @default(0)
  deliverySnapshot          Json?
  deliveryAttempts          Int                            @default(0)
  nextAttemptAt             DateTime?
  leaseUntil                DateTime?
  retryUntil                DateTime?
  responseAction            String?
  responseAt                DateTime?
  managerNotificationStatus MessageLogStatus?
  managerNotificationError  String?
  managerNotifiedAt         DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  store    Store              @relation(fields: [storeId], references: [id])
  customer Customer           @relation(fields: [customerId], references: [id])
