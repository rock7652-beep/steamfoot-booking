// ============================================================
// Cash Drawer（現金抽屜）— 每店每營業日 1 個 session
// ============================================================
// 規格：docs/cash-drawer-spec.md
//
// 三大原則：
//   1. Cash Drawer 是滾動結餘（finalBookBalance = expectedClosingCash）
//   2. 現金提領不是支出（不影響營收 / 損益 / 服務費結算）
//   3. 現金補入不是收入（不影響營收報表）
//
// 顧客現金交易：直接 query Transaction.paymentMethod=CASH，不複寫到 CashDrawerEntry
// 閉店後 session 鎖定；發現錯誤走下日 OPEN session 的 CASH_ADJUSTMENT 留痕
// ============================================================

model CashDrawerSession {
  id           String                  @id @default(cuid())
  storeId      String
  businessDate DateTime                @db.Date // UTC+8 邊界
  status       CashDrawerSessionStatus @default(OPEN)

  // 開店
  openingBookBalance Decimal  @db.Decimal(10, 0) // 應有金額（昨日 finalBookBalance 或首次設定）
  openingActualCash  Decimal  @db.Decimal(10, 0) // 實際點到金額
  openingDifference  Decimal  @db.Decimal(10, 0) // actualCash - bookBalance（可正可負）
  openingNote        String? // 差額非 0 時必填
  openedByUserId     String
  openedAt           DateTime @default(now())

  // 閉店時快照（避免重複計算 + 提速）— 全部正數量級，cashAdjustmentTotal 例外（signed）
  cashIncomeTotal     Decimal @default(0) @db.Decimal(10, 0)
  cashExpenseTotal    Decimal @default(0) @db.Decimal(10, 0) // REFUND 負值翻正後存入
  cashWithdrawalTotal Decimal @default(0) @db.Decimal(10, 0)
  cashDepositTotal    Decimal @default(0) @db.Decimal(10, 0)
  cashAdjustmentTotal Decimal @default(0) @db.Decimal(10, 0) // signed（IN 為正、OUT 為負）

  // 閉店欄位 — CLOSED 後不可修改
  expectedClosingCash Decimal?  @db.Decimal(10, 0)
  closingActualCash   Decimal?  @db.Decimal(10, 0)
  closingDifference   Decimal?  @db.Decimal(10, 0) // closingActualCash - expectedClosingCash
  closingNote         String?
  closedByUserId      String?
  closedAt            DateTime?
  finalBookBalance    Decimal?  @db.Decimal(10, 0) // (PR-5) = closingActualCash：差額留在當天，下次開店從實際現金開始

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store             @relation(fields: [storeId], references: [id])
  openedBy User              @relation("CashDrawerOpenedBy", fields: [openedByUserId], references: [id])
  closedBy User?             @relation("CashDrawerClosedBy", fields: [closedByUserId], references: [id])
  entries  CashDrawerEntry[]

  @@unique([storeId, businessDate]) // 每店每日只能一個 session
  @@index([storeId])
  @@index([businessDate])
  @@index([status])
}

model CashDrawerEntry {
  id              String              @id @default(cuid())
  storeId         String // 冗餘 — 便於 query / 報表
  sessionId       String
  businessDate    DateTime            @db.Date // 冗餘
  type            CashDrawerEntryType
  direction       CashDrawerDirection // 顯式儲存；CASH_ADJUSTMENT 可正可負
  amount          Decimal             @db.Decimal(10, 0) // 永遠正數
  reason          String // 必填
  note            String?
  createdByUserId String
  createdAt       DateTime            @default(now())

  session   CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  store     Store             @relation(fields: [storeId], references: [id])
  createdBy User              @relation("CashDrawerEntryCreatedBy", fields: [createdByUserId], references: [id])

  @@index([sessionId])
  @@index([storeId, businessDate])
  @@index([createdAt])
}

// ============================================================
// TodoDismiss（首頁待處理「我已知悉」— per-user 個人工作台狀態）
//
// PR-149：店長把首頁某筆待處理勾掉後，該筆從「他自己的」首頁消失。
//   - per-user：userA dismiss 不影響 userB（這是「我知道了」非全店處理）
//   - todoKey 由 store-todos 產生，FOLLOW_UP / LOW_SESSIONS 內嵌狀態 token，
//     狀態改變 → key 改變 → 舊 dismiss 自動失效 → 重新提醒
//   - 純新增 table，不改任何既有資料；不影響顧客 LINE / email 提醒
// ============================================================

model TodoDismiss {
  id          String   @id @default(cuid())
  userId      String // 誰 dismiss
  storeId     String // 該 todo 所屬店 — 純 metadata；刻意不設 Store FK（ADMIN 跨店時 todo 可能跨店；安全性靠 userId）
  todoKey     String // e.g. "lowsessions:cust123:wallet456"
  todoType    String // PAYMENT | BOOKING | FOLLOW_UP | LOW_SESSIONS
  dismissedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, todoKey])
  @@index([userId, storeId])
  @@index([todoType])
}

// ============================================================
// CronRunLog — durable evidence of cron invocations
//
// 動機：2026-05-23 / 5-24 提醒 cron 連續兩天沒成功跑，但 Vercel Hobby plan 的
// runtime log 保留只有 ~1 小時，事後無法 forensic。MessageLog 也不夠 — 引擎掃到 0 筆
// booking 時根本不會寫 MessageLog，從 DB 無法區分「cron 沒跑」vs「cron 跑了但沒事做」。
//
// CronRunLog 提供 durable record：
//   - 進場寫 STARTED
//   - 結束更新 OK / OK_EMPTY / PARTIAL / FAILED + counts
//   - 若 cron 完全沒被 trigger，DB 連 STARTED 都不會有 → dashboard 用「過了 18:30 仍無紀錄」推論
// ============================================================

enum CronRunStatus {
  STARTED // 進場寫入，尚未結束（finishedAt = null）
  OK // 全部 sub-task 正常 + 至少送出 1 筆
  OK_EMPTY // 全部正常但 bookingsScanned = 0（合法的安靜日）
  PARTIAL // reminder 完成但其他 sub-task fail
  FAILED // reminder 子任務 throw
}

model CronRunLog {
  id              String        @id @default(cuid())
  jobName         String // "reminders" — 為未來其他 cron 留 schema
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  status          CronRunStatus @default(STARTED)
  bookingsScanned Int? // engine 掃到幾筆 booking（即使 sent=0）
  sent            Int?
  skipped         Int?
  failed          Int?
  summary         Json? // 5 個 sub-task 的完整 results（debug 用）
  errorMessage    String?

  @@index([jobName, startedAt(sort: Desc)])
}

