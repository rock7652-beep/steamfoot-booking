generator courseClient {
  provider = "prisma-client-js"
  output   = "../generated/course-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Identity foreign keys to Store and Staff are managed in the additive SQL
// migration. This client cannot address Steamfoot or SPA commerce tables.
model CourseRoom {
  equipment String @default("")
  location String @default("")
  id        String @id @default(cuid())
  storeId   String
  name      String
  capacity Int?
  details String @default("")
  category  String @default("")
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  templates CourseTemplate[]
  sessions  CourseSession[]

  @@unique([id, storeId])
  @@unique([storeId, name])
}

model CourseTemplate {
  visibility String @default("PUBLIC")
  classType String?
  id              String @id @default(cuid())
  storeId         String
  name            String
  durationMinutes Int
  pointCost       Int
  capacity        Int
  defaultRoomId   String?
  description String @default("")
  precautions String @default("")
  category        String @default("")
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  defaultRoom     CourseRoom? @relation(fields: [defaultRoomId, storeId], references: [id, storeId])
  sessions        CourseSession[]

  @@unique([id, storeId])
  @@unique([storeId, name])
}

model CourseSession {
  id             String @id @default(cuid())
  storeId        String
  templateId     String
  roomId         String
  coachId        String
  nameSnapshot   String
  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)
  pointCost      Int
  capacity       Int
  cancelledAt    DateTime? @db.Timestamptz(3)
  requestKey     String
  requestIndex   Int
  createdById    String
  createdAt      DateTime @default(now())
  rescheduledFromStartsAt DateTime? @db.Timestamptz(3)
  rescheduledFromEndsAt   DateTime? @db.Timestamptz(3)
  rescheduleKind          String?
  rescheduledAt           DateTime? @db.Timestamptz(3)
  rescheduledById         String?
  bookings       CourseBooking[]
  moves          CourseSessionMove[]
  template       CourseTemplate @relation(fields: [templateId, storeId], references: [id, storeId])
  room           CourseRoom @relation(fields: [roomId, storeId], references: [id, storeId])

  @@unique([id, storeId])
  @@unique([storeId, requestKey, requestIndex])
  @@index([storeId, startsAt])
  @@index([storeId, coachId, startsAt])
  @@index([storeId, roomId, startsAt])
}

model CourseSessionMove {
  id             String @id @default(cuid())
  storeId        String
  sessionId      String
  scope          String
  fromStartsAt   DateTime @db.Timestamptz(3)
  fromEndsAt     DateTime @db.Timestamptz(3)
  fromRoomId     String
  fromCoachId    String
  toStartsAt     DateTime @db.Timestamptz(3)
  toEndsAt       DateTime @db.Timestamptz(3)
  toRoomId       String
  toCoachId      String
  actorUserId    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  session        CourseSession @relation(fields: [sessionId, storeId], references: [id, storeId])

  @@index([storeId, createdAt])
  @@index([storeId, sessionId])
}

model CoursePointPlan {
  storeCost Int @default(0)
  termSessionIds String[] @default([])
  customerPurchasable Boolean @default(true)
  allowShared Boolean @default(false)
  id String @id @default(cuid())
  storeId String
  name String
  points Int
  price Int @default(0)
  validDays Int
  isActive Boolean @default(true)
  unit String @default("POINT")
  lowBalanceEnabled Boolean @default(false)
  lowBalanceThreshold Int?
  templateIds String[] @default([])
  cards CoursePointCard[]
  @@unique([id, storeId])
  @@unique([storeId, name])
}

model CourseBalanceReminderPreference {
  id String @id @default(cuid())
  storeId String
  customerId String
  stoppedAt DateTime? @db.Timestamptz(3)
  lastEventAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([storeId, customerId])
}

model CoursePointCard {
  termSessionIds String[] @default([])
  id String @id @default(cuid())
  storeId String
  planId String
  nameSnapshot String
  unit String @default("POINT")
  templateIds String[] @default([])
  remaining Int
  closedAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  requestKey String
  createdAt DateTime @default(now())
  plan CoursePointPlan @relation(fields: [planId, storeId], references: [id, storeId])
  members CourseCardMember[]
  bookings CourseBooking[]
  entries CoursePointEntry[]
  @@unique([id, storeId])
  @@unique([storeId, requestKey])
}

model CourseCardMember {
  cardId String
  storeId String
  customerId String
  card CoursePointCard @relation(fields: [cardId, storeId], references: [id, storeId])
  @@id([cardId, customerId])
  @@index([storeId, customerId])
}

model CourseBooking {
  id String @id @default(cuid())
  storeId String
  sessionId String
  cardId String?
  bookingKind String @default("CARD")
  trialPrice Int?
  customerId String
  operatorUserId String
  operatorCustomerId String?
  operatorName String
  customerName String
  pointCost Int
  status String @default("RESERVED")
  checkedInAt DateTime? @db.Timestamptz(3)
  notes String @default("")
  requestKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  card CoursePointCard? @relation(fields: [cardId, storeId], references: [id, storeId])
  trialPayments CourseTrialPayment[]
  session CourseSession @relation(fields: [sessionId, storeId], references: [id, storeId])
  entries CoursePointEntry[]
  @@unique([id, storeId])
  @@unique([storeId, requestKey])
  @@index([storeId, sessionId, status])
  @@index([storeId, cardId, status])
}

// Trial receipts never create a point card or settle attendance.
model CourseTrialPayment {
  id String @id @default(cuid())
  storeId String
  bookingId String
  amount Int
  paymentMethod String
  paymentSplits Json?
  status String @default("SUCCESS")
  note String @default("")
  requestKey String
  actorUserId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  voidedAt DateTime? @db.Timestamptz(3)
  voidReason String?
  booking CourseBooking @relation(fields: [bookingId, storeId], references: [id, storeId])
  @@unique([storeId, requestKey])
  @@index([storeId, createdAt])
}

model CoursePointEntry {
  id String @id @default(cuid())
  storeId String
  cardId String
  bookingId String?
  kind String
  points Int
  actorUserId String
  createdAt DateTime @default(now())
  card CoursePointCard @relation(fields: [cardId, storeId], references: [id, storeId])
  booking CourseBooking? @relation(fields: [bookingId, storeId], references: [id, storeId])
  @@unique([bookingId, kind])
  @@index([storeId, cardId, createdAt])
}

model CourseBookingRule {
  storeId String @id
  bookingLeadMinutes Int @default(0)
  cancellationLeadMinutes Int @default(0)
  @@map("CourseBookingRule")
}

model CoursePurchase {
  storeCostSnapshot Int?
  developerProfitSnapshot Int?
  developerNameSnapshot String?
  termSessionIds String[] @default([])
  id String @id @default(cuid())
  storeId String
  customerId String
  planId String
  name String
  unit String
  points Int
  price Int
  validDays Int
  templateIds String[]
  status String @default("PENDING")
  transferLastFive String
  listPrice Int?
  discountKind String?
  discountValue Decimal? @db.Decimal(12,2)
  paymentMethod String?
  transferLastFour String?
  requestKey String
  cardId String?
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  confirmedBy String?
  note String @default("")
  revenueStaffId String?
  voidedAt DateTime? @db.Timestamptz(3)
  voidedBy String?
  voidReason String?
  refunds CoursePurchaseRefund[]
  @@unique([id, storeId])
  @@unique([storeId, requestKey])
  @@index([storeId, customerId, createdAt])
}

// Immutable financial reversal. The original purchase and member history remain.
model CoursePurchaseRefund {
  id String @id @default(cuid())
  storeId String
  purchaseId String
  amount Int
  points Int
  reason String
  method String @default("OTHER")
  actorUserId String
  requestKey String
  createdAt DateTime @default(now())
  purchase CoursePurchase @relation(fields: [purchaseId, storeId], references: [id, storeId])
  @@unique([storeId, requestKey])
  @@index([storeId, createdAt])
  @@index([purchaseId])
}

// FKs, RLS and snapshot trigger are managed by the additive SQL migration.
model CourseCompensation {
  storeId String
  templateId String
  staffId String @default("")
  rules Json
  revision Int @default(1)
  updatedAt DateTime @default(now()) @db.Timestamptz
  @@id([storeId, templateId, staffId])
}
model CourseCompensationSnapshot {
  sessionId String @id
  storeId String
  staffId String
  rule Json
  revision Int
  durationMinutes Int
  createdAt DateTime @default(now()) @db.Timestamptz
}

// Course-only payment ledger. SQL migration owns FKs and RLS.
model CourseFeePayment {
  id String @id
  storeId String
  sessionId String
  staffId String
  staffNameSnapshot String
  amount Int
  method String
  note String
  requestKey String
  actorUserId String
  createdAt DateTime @default(now()) @db.Timestamptz
  voidedAt DateTime? @db.Timestamptz
  voidReason String?
  voidedBy String?
  @@unique([storeId, requestKey])
  @@index([storeId, createdAt], map: "CourseFeePayment_store_created")
}
