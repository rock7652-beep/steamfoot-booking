generator spaClient {
  provider = "prisma-client-js"
  // Keep generated Prisma runtime code outside Next's source tree. Otherwise
  // Turbopack's NFT tracer follows Prisma's dynamic runtime loader as though it
  // were application source and warns that it traced the entire project.
  output   = "../generated/spa-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SpaBookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SpaAvailabilityExceptionType {
  UNAVAILABLE
  AVAILABLE
}

model SpaBooking {
  id                  String           @id @default(cuid())
  storeId             String
  customerId          String
  serviceStaffId      String
  serviceLocationId   String?
  bookingDate         DateTime         @db.Date
  startTime           String
  endTime             String
  status              SpaBookingStatus @default(CONFIRMED)
  serviceNameSnapshot String
  totalPriceSnapshot  Decimal          @db.Decimal(10, 0)
  partyGroupId        String?
  guestIndex          Int @default(1)
  requestKey          String?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  items               SpaBookingItem[]
  receipt             SpaReceipt?
  serviceLocation     SpaServiceLocation? @relation(fields: [serviceLocationId, storeId], references: [id, storeId])

  @@unique([storeId, requestKey])
  @@unique([id, storeId])
  @@index([storeId, bookingDate, startTime])
  @@index([storeId, serviceStaffId, bookingDate])
  @@index([storeId, serviceLocationId, bookingDate])
  @@index([storeId, customerId, bookingDate])

  revenueStaffId      String?
  people              Int              @default(1)
  checkedInAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  entitlementUses    SpaEntitlementUse[]
  payments           SpaPayment[]
  storedValueEntries SpaStoredValueEntry[]
  @@index([storeId, status])
  @@index([storeId, partyGroupId])
}

model SpaBookingItem {
  id                    String   @id @default(cuid())
  storeId               String
  bookingId             String
  treatmentId           String
  treatmentNameSnapshot String
  priceSnapshot         Decimal  @db.Decimal(10, 0)
  serviceMinutes        Int
  bufferMinutes         Int      @default(0)
  sortOrder             Int      @default(0)
  booking               SpaBooking @relation(fields: [bookingId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([bookingId, sortOrder])
  @@index([storeId, treatmentId])

  variantSnapshot       String?
  createdAt             DateTime @default(now())
}

model SpaTreatment {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  variantLabel   String?
  price          Decimal  @db.Decimal(10, 0)
  serviceMinutes Int
  bufferMinutes  Int      @default(0)
  publicVisible  Boolean  @default(true)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  skills         SpaTreatmentSkill[]
  serviceLocations SpaTreatmentServiceLocation[]

  @@unique([id, storeId])
  @@unique([storeId, name, variantLabel])
  @@index([storeId, publicVisible, isActive, sortOrder])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SpaServiceLocation {
  id        String @id @default(cuid())
  storeId   String
  name      String
  isActive  Boolean @default(true)
  sortOrder Int @default(0)
  bookings  SpaBooking[]
  treatments SpaTreatmentServiceLocation[]
  @@unique([id, storeId])
  @@unique([storeId, name])
  @@index([storeId, isActive, sortOrder])
}

model SpaTreatmentServiceLocation {
  storeId String
  treatmentId String
  serviceLocationId String
  treatment SpaTreatment @relation(fields: [treatmentId, storeId], references: [id, storeId], onDelete: Cascade)
  serviceLocation SpaServiceLocation @relation(fields: [serviceLocationId, storeId], references: [id, storeId], onDelete: Cascade)
  @@id([treatmentId, serviceLocationId])
  @@index([storeId, serviceLocationId])
}

model SpaSkill {
  id String @id @default(cuid())
  storeId String
  name String
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  treatments SpaTreatmentSkill[]
  staff SpaStaffSkill[]

  @@unique([id, storeId])
  @@unique([storeId, name])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([storeId, isActive, sortOrder])
}

model SpaTreatmentSkill {
  storeId String
  treatmentId String
  skillId String
  treatment SpaTreatment @relation(fields: [treatmentId, storeId], references: [id, storeId], onDelete: Cascade)
  skill SpaSkill @relation(fields: [skillId, storeId], references: [id, storeId], onDelete: Cascade)
  @@id([treatmentId, skillId])
  @@index([storeId, skillId])


}

model SpaStaffSkill {
  storeId String
  staffId String
  skillId String
  skill SpaSkill @relation(fields: [skillId, storeId], references: [id, storeId], onDelete: Cascade)
  @@id([staffId, skillId])
  @@index([storeId, skillId])


}

model SpaStaffAvailability {
  id String @id @default(cuid())
  storeId String
  staffId String
  dayOfWeek Int
  startTime String
  endTime String
  isActive Boolean @default(true)
  @@unique([storeId, staffId, dayOfWeek])
  @@index([storeId, staffId, isActive])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpaStaffAvailabilityException {
  id String @id @default(cuid())
  storeId String
  staffId String
  date DateTime @db.Date
  type SpaAvailabilityExceptionType
  startTime String?
  endTime String?
  reason String?
  @@index([storeId, staffId, date])

  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
}

model SpaReceipt {
  id String @id @default(cuid())
  storeId String
  bookingId String
  amount Decimal @db.Decimal(10, 0)
  currency String @default("TWD")
  paymentMethod String
  transferLast4 String? @db.VarChar(4)
  sourceId String?
  balanceAfter Decimal? @db.Decimal(10, 0)
  uses Int?
  recordedByUserId String
  paidAt DateTime @default(now())
  booking SpaBooking @relation(fields: [bookingId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([bookingId, storeId])
  @@index([storeId, paidAt])
}

model SpaPackage {
  id String @id @default(cuid())
  storeId String
  treatmentId String
  name String
  price Decimal @db.Decimal(10,0)
  uses Int
  validityDays Int
  isActive Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@unique([id,storeId])
  @@index([storeId,isActive])
}

model SpaCreditSale {
  id String @id @default(cuid())
  storeId String
  customerId String
  requestKey String
  fingerprint String
  kind String
  name String
  amount Decimal @db.Decimal(10,0)
  paymentMethod String
  transferLast4 String? @db.VarChar(4)
  sourceId String
  recordedByUserId String
  createdAt DateTime @default(now())
  @@unique([storeId,requestKey])
  @@unique([id,storeId])
  @@index([storeId,customerId,createdAt])
}

model SpaRefund {
  id String @id @default(cuid())
  storeId String
  customerId String
  saleId String?
  receiptId String?
  amount Decimal @db.Decimal(10,0)
  paymentMethod String
  transferLast4 String? @db.VarChar(4)
  uses Int?
  reason String
  recordedByUserId String
  createdAt DateTime @default(now())
  @@unique([storeId,saleId])
  @@unique([storeId,receiptId])
  @@index([storeId,customerId,createdAt])
}

model SpaBookingGroup {
  id String @id @default(cuid())
  storeId String
  customerId String
  requestKey String
  fingerprint String
  createdAt DateTime @default(now())
  @@unique([storeId,requestKey])
  @@unique([id,storeId])
}

enum SpaEntitlementStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  VOIDED
}

enum SpaEntitlementUseStatus {
  RESERVED
  COMPLETED
  RELEASED
  VOIDED
}

enum SpaPaymentStatus {
  PENDING
  SUCCESS
  VOIDED
  REFUNDED
}

enum SpaPaymentMethod {
  CASH
  TRANSFER
  LINE_PAY
  CREDIT_CARD
  STORED_VALUE
  ENTITLEMENT
  OTHER
}

enum SpaStoredValueEntryType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
  VOID
}

model SpaEntitlement {
  id              String               @id @default(cuid())
  storeId         String
  customerId      String
  treatmentId     String?
  nameSnapshot    String
  purchasedPrice  Decimal              @db.Decimal(10, 0)
  totalUses       Int
  remainingUses   Int
  startDate       DateTime             @db.Date
  expiryDate      DateTime?            @db.Date
  status          SpaEntitlementStatus @default(ACTIVE)
  sourceReference String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  uses SpaEntitlementUse[]

  @@unique([id, storeId])
  @@index([storeId, customerId, status, expiryDate])
  @@index([storeId, treatmentId])
}

model SpaEntitlementUse {
  id            String                  @id @default(cuid())
  storeId       String
  entitlementId String
  bookingId     String
  uses          Int                     @default(1)
  status        SpaEntitlementUseStatus @default(RESERVED)
  reservedAt    DateTime                @default(now())
  completedAt   DateTime?
  releasedAt    DateTime?

  entitlement SpaEntitlement @relation(fields: [entitlementId, storeId], references: [id, storeId], onDelete: Restrict)
  booking     SpaBooking     @relation(fields: [bookingId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([entitlementId, bookingId])
  @@index([storeId, bookingId, status])
}

model SpaPayment {
  id                String           @id @default(cuid())
  storeId           String
  customerId        String
  bookingId         String
  revenueStaffId    String?
  soldByStaffId     String?
  grossAmount       Decimal          @db.Decimal(10, 0)
  netAmount         Decimal          @db.Decimal(10, 0)
  paymentMethod     SpaPaymentMethod
  status            SpaPaymentStatus @default(SUCCESS)
  quantity          Int              @default(1)
  refundOfPaymentId String?
  paidAt            DateTime?
  voidedAt          DateTime?
  refundedAt        DateTime?
  refundReason      String?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  booking            SpaBooking            @relation(fields: [bookingId, storeId], references: [id, storeId], onDelete: Restrict)
  refundOfPayment    SpaPayment?           @relation("SpaPaymentRefunds", fields: [refundOfPaymentId], references: [id], onDelete: Restrict)
  refunds            SpaPayment[]          @relation("SpaPaymentRefunds")
  storedValueEntries SpaStoredValueEntry[]

  @@unique([id, storeId])
  @@index([storeId, bookingId, status])
  @@index([storeId, customerId, createdAt])
  @@index([storeId, revenueStaffId, createdAt])
  @@index([refundOfPaymentId])
}

model SpaStoredValueWallet {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  balance    Decimal  @default(0) @db.Decimal(10, 0)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entries SpaStoredValueEntry[]

  @@unique([storeId, customerId])
  @@unique([id, storeId])
  @@index([storeId, status])
}

model SpaStoredValueEntry {
  id           String                  @id @default(cuid())
  walletId     String
  storeId      String
  customerId   String
  bookingId    String?
  paymentId    String?
  entryType    SpaStoredValueEntryType
  amount       Decimal                 @db.Decimal(10, 0)
  balanceAfter Decimal                 @db.Decimal(10, 0)
  note         String?
  createdAt    DateTime                @default(now())

  wallet  SpaStoredValueWallet @relation(fields: [walletId, storeId], references: [id, storeId], onDelete: Cascade)
  booking SpaBooking?          @relation(fields: [bookingId, storeId], references: [id, storeId], onDelete: Restrict)
  payment SpaPayment?          @relation(fields: [paymentId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([storeId, bookingId, entryType])
  @@unique([storeId, paymentId, entryType])
  @@index([storeId, customerId, createdAt])
  @@index([walletId, createdAt])
}

model SpaStaffCompensation {
  id        String              @id @default(cuid())
  storeId   String
  staffId   String              @unique
  mode      String
  value     Decimal             @db.Decimal(10, 2)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([storeId, isActive])
}
